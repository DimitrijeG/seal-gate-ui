# Copy to .env beside compose.yaml. .env is never committed.

# The public domain, its DNS pointing at the server. Leave unset locally for localhost.
SITE_ADDRESS=

# Image tags: latest, or a commit (sha-1a2b3c4) to pin or roll back.
SEAL_GATE_TAG=latest
CONSOLE_TAG=latest

# Only with compose.postgres.yaml. Letters and digits only: it is placed in a URL unescaped.
POSTGRES_PASSWORD=
